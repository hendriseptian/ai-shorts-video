{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-shorts-video",
  "main": "src/main.py",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["python_workers"],

  "r2_buckets": [
    {
      "binding": "MIKO_MEDIA",
      "bucket_name": "miko-media"
    }
  ]
}
