{
  "bible": {
    "name": "Miko World Bible",
    "version": "1.0",
    "status": "ACTIVE"
  },
  "visual_world": {
    "style": "high_quality_stylized_3d_childrens_animation",
    "shape_language": "soft, rounded, simple and cute",
    "primary_colors": [
      "orange",
      "blue",
      "yellow",
      "green"
    ],
    "secondary_colors": [
      "pink",
      "purple",
      "soft_red",
      "white"
    ],
    "color_mood": "bright, warm and cheerful",
    "avoid": [
      "dark_gloomy_grading",
      "excessive_neon",
      "harsh_lighting",
      "horror_lighting"
    ]
  },
  "lighting": {
    "day": "soft sunlight, warm bright lighting, soft shadows",
    "afternoon": "warm golden light with orange or pink sky",
    "night": "soft blue lighting, moonlight and glowing fireflies",
    "general_rule": "Lighting must remain safe, warm and child-friendly."
  },
  "camera": {
    "default_aspect_ratio": "9:16",
    "target_resolution": "1080x1920",
    "preferred_shots": [
      "medium",
      "close_up",
      "full_body",
      "wide_establishing"
    ],
    "camera_rule": "Keep Miko large enough on screen for children to clearly see his face and expressions.",
    "avoid": [
      "excessive_wide_shots_that_make_miko_tiny",
      "shaky_camera",
      "rapid_zoom",
      "extreme_camera_motion"
    ]
  },
  "background": {
    "rule": "Backgrounds should be detailed enough to establish the world but not so busy that they distract from Miko.",
    "priority": "Miko remains the visual focus."
  },
