# ==========================================
# AI SHORTS VIDEO
# ENVIRONMENT CONFIGURATION
# ==========================================

# Application
APP_NAME=AI Shorts Video
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0

# Backend
HOST=0.0.0.0
PORT=8000

# AI Provider
AI_PROVIDER=

# AI API Keys
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Video Generation
VIDEO_PROVIDER=
VIDEO_API_KEY=

# Voice Generation
VOICE_PROVIDER=
VOICE_API_KEY=

# YouTube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/auth/youtube/callback

# Storage
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Database
DATABASE_URL=

# Security
SECRET_KEY=change-this-in-production

# Generation Settings
DEFAULT_LANGUAGE=id
DEFAULT_VIDEO_DURATION=60
DEFAULT_VIDEO_WIDTH=1080
DEFAULT_VIDEO_HEIGHT=1920
DEFAULT_FPS=30

# Miko
MIKO_CHARACTER_ID=MIKO
MIKO_CHARACTER_VERSION=1.0

# Development
LOG_LEVEL=INFO
